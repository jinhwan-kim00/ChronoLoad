<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!--
      정보 창과 파일 속성이 보여주는 값. 기능 단위로 올린다
      (M6 MCP → 0.9, M7 안정화 + M8 스냅샷 창 → 1.0).
      Version 하나가 AssemblyVersion·FileVersion·InformationalVersion 을 모두 끌고 간다.
    -->
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF 텍스트 레이아웃이 실제 컬처를 요구한다. InvariantGlobalization 은 켤 수 없다. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- 센서 루프에서 할당을 피하려면 Span/ref struct 사용이 잦다 -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>

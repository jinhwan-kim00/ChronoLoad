<Application x:Class="ChronoLoad.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>

    <!--
      OS 기본 스크롤바는 다크 팔레트 위에서 하얀 기둥으로 남고, 화살표 단추까지 달려
      폭이 17dip 이라 창 가장자리를 밀고 나간 것처럼 보인다. 여기서는 손잡이만 남긴다.
      브러시는 DynamicResource 라 테마 전환을 그대로 따라간다(ThemeService).
    -->
    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <!-- 투명이되 히트 테스트는 된다. 빈 자리를 눌러 페이지 단위로 넘길 수 있어야 한다. -->
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollBar.Handle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Handle" CornerRadius="3" Margin="3"
                    Background="{DynamicResource Brush.Faint}"
                    SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Brush.Dim}"/>
                <Setter TargetName="Handle" Property="Margin" Value="2"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Brush.Dim}"/>
                <Setter TargetName="Handle" Property="Margin" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent" SnapsToDevicePixels="True">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PageBack" Style="{StaticResource ScrollBar.Page}"
                                Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollBar.Handle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PageForward" Style="{StaticResource ScrollBar.Page}"
                                Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Track 은 방향을 스스로 따라가지 않는다. 지금 가로 스크롤을 쓰는 곳은
                   없지만, 암시적 스타일이라 언젠가 쓰는 순간 조용히 망가진다. -->
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="MinHeight" Value="12"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>

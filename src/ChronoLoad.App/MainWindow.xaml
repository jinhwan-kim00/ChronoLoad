<Window x:Class="ChronoLoad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ChronoLoad"
        Width="340" Height="620"
        MinWidth="300" MinHeight="420" MaxWidth="420"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Bg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <!--
    WindowStyle="None" 만으로는 창 위쪽 5dip 이 비클라이언트로 남고, DWM 이 그 띠를 기본
    프레임 색으로 칠한다 — 다크 테마에서 타이틀바 위에 흰 줄로 보인다(실측: 물리 10px,
    타이틀바 밑줄이 34dip 이 아니라 39dip 에 찍혔다).
    GlassFrameThickness="0" 으로 그 띠를 없애 클라이언트가 창 전체를 덮게 한다.
    CaptionHeight="0" 인 이유는 끌기를 TitleBar 의 DragMove 로 직접 처리하기 때문이다 —
    0 이 아니면 시스템 캡션이 그 영역을 먼저 가져가 버튼 클릭이 먹지 않는다.
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- 타이틀바 아이콘 버튼. 텍스트 없이 16px 글리프만 -->
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <!-- 크롬은 한 줄이다. 리셋·경과 시간을 타이틀바에 합쳐 전역 바를 없앴다 —
         구석에 세워 두는 위젯에서 세로 44px 은 카드 하나의 절반이 넘는다. -->
    <Grid.RowDefinitions>
      <RowDefinition Height="34"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 타이틀바 : 앱 이름 텍스트 없음. 리셋·경과 시간·창 조작이 한 줄에 들어간다 -->
    <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Line}"/>
      <!--
        상단 6dip 은 WindowChrome 의 리사이즈 테두리라 기본적으로 클릭을 창 크기 조절로 가져간다.
        버튼은 타이틀바 안에서 세로 가운데 정렬(위쪽이 6dip)이라 그 띠와 정확히 맞닿는다 —
        표시만으로는 멀쩡해 보이는데 버튼 윗변이 안 눌리는 상태가 된다.
        DockPanel 에만 표시해서 버튼은 전부 눌리고, 버튼 사이 빈 곳으로는 여전히 위에서 잡아
        크기를 조절할 수 있게 둔다.
      -->
      <DockPanel Margin="9,0,6,0" LastChildFill="False"
                 shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <ContentControl x:Name="BrandHost" DockPanel.Dock="Left" VerticalAlignment="Center"
                        Margin="0,0,9,0"/>
        <!--
          ⟲ 와 스냅샷은 짝이다 — 하나는 측정 구간의 시작점을 옮기고, 하나는 그 구간을 통째로
          떠낸다(§8.8). 둘 다 "지금 재고 있는 것"을 다루므로 같은 모양·같은 자리에 둔다.
        -->
        <Button x:Name="ResetButton" Style="{StaticResource ActionButton}" DockPanel.Dock="Left"/>
        <Button x:Name="SnapshotButton" Style="{StaticResource ActionButton}" DockPanel.Dock="Left"
                Margin="5,0,0,0" ToolTip="스냅샷 창 — 지금 버퍼를 복제해 고정 표시"/>

        <TextBlock x:Name="ElapsedText" DockPanel.Dock="Left" Margin="8,0,0,0"
                   FontFamily="Cascadia Mono, Consolas" FontSize="13"
                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Fg}" Text="00:00"/>
        <!--
          시간 폭은 표준(60s)이 아닐 때만 말한다(§9.4). 기본 상태에서 자리를 차지하지 않으면서,
          벗어나 있을 때는 그 사실이 화면에 남아 더블클릭이 무엇을 되돌리는지도 가리킨다.
        -->
        <Border x:Name="TimeWidthChip" DockPanel.Dock="Left" Margin="7,0,0,0" Padding="5,1"
                CornerRadius="5" VerticalAlignment="Center" Visibility="Collapsed"
                Background="{DynamicResource Brush.Surface2}"
                BorderThickness="1" BorderBrush="{DynamicResource Brush.Line}">
          <TextBlock x:Name="TimeWidthText" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                     Foreground="{DynamicResource Brush.Dim}" Text="60s"/>
        </Border>
        <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}" DockPanel.Dock="Right"/>
        <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" DockPanel.Dock="Right"/>
        <Button x:Name="ThemeButton" Style="{StaticResource ChromeButton}" DockPanel.Dock="Right"/>
        <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" DockPanel.Dock="Right"/>
        <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" DockPanel.Dock="Right"/>
      </DockPanel>
    </Grid>

    <!-- 카드 스택 : 스크롤 없음. 공간이 모자라면 자동 접힘이 처리한다 -->
    <StackPanel x:Name="CardHost" Grid.Row="1" Margin="8"/>

    <!-- 카드의 등장·소멸 자체가 알림이지만, 그것이 보이지 않는 사용자에게는 닿지 않는다.
         화면을 차지하지 않으면서 스크린 리더에는 읽히도록 라이브 영역 하나를 둔다.
         Visibility.Collapsed 는 접근성 트리에서도 빠지므로 쓰지 않는다. -->
    <TextBlock x:Name="LiveRegion" Grid.Row="1" Height="0" Opacity="0"
               IsHitTestVisible="False" Focusable="False"
               AutomationProperties.LiveSetting="Polite"/>

  </Grid>
</Window>
